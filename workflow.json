    {
      "parameters": {
        "jsCode": "const feeds = [\n  {\n    \"url\": \"https://tr.sputniknews.com/export/rss2/archive/index.xml\",\n    \"source\": \"Sputnik\"\n  },\n  {\n    \"url\": \"https://www.cumhuriyet.com.tr/rss\",\n    \"source\": \"Cumhuriyet\"\n  },\n  {\n    \"url\": \"https://www.sozcu.com.tr/feed/\",\n    \"source\": \"Sozcu\"\n  }\n];\n\n// To add more feeds, simply add a new object to the array above.\n\nreturn feeds.map(feed => ({ json: feed }));"
      },
