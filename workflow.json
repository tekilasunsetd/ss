    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst source = $('Loop Over Feeds').item.json.source;\n\n// Normalize data to handle inconsistencies between RSS feeds\nconst normalized = {};\n\nnormalized.source = source;\n\n// Title\nnormalized.title = item.title?.[0] || '';\n\n// Link\nnormalized.link = item.link?.[0] || '';\n\n// GUID - Look in different places\nnormalized.guid = item.guid?.[0]?._ || item.guid?.[0] || item.id?.[0] || '';\n\n// Publication Date - Try to parse whatever format is given\nconst pubDateString = item.pubDate?.[0] || item.published?.[0] || item.updated?.[0] || '';\nnormalized.pubDate = new Date(pubDateString).toISOString();\n\n// Content Snippet/Description\nnormalized.contentSnippet = item['content:encoded']?.[0] || item.description?.[0] || '';\n\n// For simplicity, we'll just pass the whole original item through for now\n// in case other fields are needed downstream.\nnormalized.originalItem = item;\n\n$input.item.json = normalized;\n\nreturn $input.item;"
      },
      "id": "f6a7b8c9-d1e2-4f3a-b4c5-d6e7f8a9b1c2",
